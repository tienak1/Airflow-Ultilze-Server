---
apiVersion: v1
kind: Pod
metadata:
  name: placeholder-name
spec:
  containers:
      image: apache/airflow:2.2.4
      imagePullPolicy: IfNotPresent
      name: base
      volumeMounts:
        - mountPath: "/opt/airflow/logs"
          name: logs-pv
        - mountPath: /opt/airflow/dags
          name: dags-pv
          readOnly: true
  restartPolicy: Never
  securityContext:
    runAsUser: 50000
    fsGroup: 50000
  serviceAccountName: "airflow-scheduler"
  volumes:
    - name: dags-pv 
      persistentVolumeClaim: 
        claimName: dags-pvc 
    - name: logs-pv 
      persistentVolumeClaim: 
        claimName: logs-pvc 
